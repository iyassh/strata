  "_method": {
    "net": "strata.core.pipeline.fit(cfg, healthy_df).unit_model -> .net/.im/.fm (inductive miner, noise_threshold=0.2, state_only() unit-stratum slice, discovered on TRAIN days only per core.detection.build_detector)",
    "alignments": "pm4py 2.7.22.5, pm4py.algo.conformance.alignments.petri_net.algorithm.apply(EventLog, net, im, fm, variant=VERSION_STATE_EQUATION_A_STAR) - the default optimal-alignment variant; log-order preserving, so no case-id sort assumption. Each alignment's log-move projection was asserted equal to its input trace.",
    "sync_move": "a pair (log_move, model_move) with both == 'heating_active'",
    "Q_support": "aligned once per distinct variant, then mapped to days; denominator is all healthy occupied days from pipeline.day_universe (occupied_min > 0). 0 occupied days lacked state events on any system.",
    "Q_obligatory": "every distinct variant of the healthy unit-stratum state log, with every heating_active event deleted, aligned; cost 0 == fitness 1.0",
    "device_stratum": "The detector holds ONE POOLED device net (StrataDetector.device_model.net), not one net per device: devices.device_templates strips the zone token, so cases are '<day>__<device>' over pooled class activities. The device-stratum heating activity is therefore named 'zone_heating_active' with NO '@<device>' suffix; device identity lives in the case id. Q_support_device = mean over the 4 devices of (occupied days whose day-device alignment has a sync move on zone_heating_active) / (365 occupied days); a device silent on a day contributes no trace and counts as no sync move. Q_obligatory_device computed pooled over all device variants and also per device.",
    "amendment_1": "Per team-lead: seal holds only for the six MR2/MR3 cells; SDAHU's three cells are excluded from P1/P2 as degenerate but computed and reported as defined."
  }
